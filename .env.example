# ──────────────────────────────────────────────────────────────────────
# Path A (recommended for local dev): OpenRouter single key
# ──────────────────────────────────────────────────────────────────────
# One key reaches Claude, GPT, Gemini, Llama, Mistral, etc. via an
# OpenAI-compatible API. Cheapest and simplest path to a live panel.
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=quorum
OPENROUTER_SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────
# Path B: native provider keys (used when not routing via OpenRouter)
# ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
GOOGLE_API_KEY=xxx

# Cloudflare Workers AI (4th provider, open-source models)
# Get from: https://dash.cloudflare.com → AI → Workers AI → API tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare AI Gateway (optional but strongly recommended for eval runs)
# When set, ALL 4 providers route through this URL for caching + observability + fallback.
# Format: https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_slug}
# Create at: https://dash.cloudflare.com → AI → AI Gateway → Create gateway
CLOUDFLARE_AI_GATEWAY_URL=

# Quorum service ports
QUORUM_API_PORT=8000
QUORUM_FRONTEND_PORT=3000
QUORUM_MCP_PORT=8001

# Default model for orchestrator.
# When using OpenRouter, use vendor-prefixed names (e.g. anthropic/claude-opus-4).
# When using native providers, use the bare slugs in llm/client.py ModelName.
QUORUM_DEFAULT_MODEL=anthropic/claude-opus-4

# Cumulative spend cap across ALL LLM calls (agents, eval, MCP, smoke tests).
# Tracked in ~/.quorum/spend.json. LLMClient refuses new calls past this cap
# with a RuntimeError that halts /goal cleanly. Reset by deleting the file.
QUORUM_TOTAL_SPEND_LIMIT_USD=15
