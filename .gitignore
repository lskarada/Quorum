# Data (commit schemas, not contents)
data/cases/nejm/*.json
data/cases/medqa/*.json
data/cases/cupcase/*.json
data/cases/mcr/*.json
# v2 corpus: NEJM cases are paywalled — do NOT commit the JSON bodies.
# MCR (MIT) and RareBench (Apache 2.0) JSON bodies ARE committed.
# Splits.json is committed (just case-IDs, no copyrighted content).
data/cases/eval_corpus_v2/nejm_sample.json
# DEV set: also NEJM-paywalled — do NOT commit. Held in a SEPARATE file from
# nejm_sample.json so a splits.json re-split can never pull DEV into EVAL/TUNE.
data/cases/eval_corpus_v2/dev_nejm_sample.json
data/cases/eval_corpus_v2/_dev_nejm_raw/
!data/cases/eval_corpus_v2/mcr_sample.json
# DEV augmentation: MCR (MIT) is public + committable, unlike the paywalled NEJM DEV file.
!data/cases/eval_corpus_v2/dev_mcr_sample.json
!data/cases/eval_corpus_v2/rarebench_sample.json
!data/cases/eval_corpus_v2/splits.json
!data/cases/eval_corpus_v2/README.md
!data/cases/**/_schema.json
data/results/*.json
data/results/*/
data/results/.spend_total.txt
data/results/.spend_ledger.tsv
# Local benchmark tooling — holdout SC driver scripts + run markers (not for the repo)
data/results/.holdout_*
# v3 NEJM holdout — committed voted artifacts (per-case judge verdicts + audit
# trails) so the README headline is reproducible/inspectable from a clean clone.
# These contain only final-diagnosis names, model commitments, scores, posteriors
# and costs — NO paywalled NEJM case bodies. See docs/results_v3.md.
!data/results/v3-holdout-sc-voted/
!data/results/v3-holdout-baseline-voted/
data/prompt_iteration/
!data/cases/**/.gitkeep
!data/results/.gitkeep
# v2 benchmark attribution + diagnostics artifacts (small JSON summaries,
# not raw per-case data). Committed so a reviewer can reproduce phase 6
# tables without re-running the $20+ benchmark.
!data/results/v1_baseline_frozen.json
!data/results/v2_*.json
!data/results/v2_*.jsonl
!data/results/v2_*.md
!data/results/ensemble_cost_priors/
!data/results/ensemble_cost_priors/*.json

# data/schemas/quorum.schema.json IS committed — it's the generated
# Pydantic↔TypeScript parity contract. Regenerate with:
#   cd backend && uv run python scripts/dump_schemas.py

# Logs
*.log

# Generated artifacts
.pytest-cache/
.next/
out/

# Superpowers brainstorm artifacts (local only)
.superpowers/

# Claude Code working context (local only — not published to the repo)
.claude/
/CLAUDE.md
/rubric.md
